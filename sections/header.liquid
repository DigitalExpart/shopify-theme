{%- comment -%}
  Header Section - The Amendment Company (1776)
{%- endcomment -%}

<header class="header" data-header-sticky style="background-color: var(--color-bg-primary); border-bottom: 1px solid var(--color-border); position: sticky; top: 0; z-index: var(--z-header); box-shadow: var(--shadow-sm); transition: transform var(--transition-base);">
  <div class="page-width flex-between" style="height: 95px; gap: 1.5rem;">

    {%- comment -%} Mobile Menu Toggle {%- endcomment -%}
    <button type="button" class="icon-btn mobile-only" data-drawer-trigger="mobile-menu-drawer" aria-label="{{ 'general.accessibility.menu' | t }}" style="display: none;">
      {% render 'icon-menu' %}
    </button>

    {%- comment -%} Brand Logo - Eagle Crest & Text {%- endcomment -%}
    <div class="header__logo" style="margin-right: auto; padding-left: 0;">
      <a href="{{ routes.root_url }}" style="font-family: var(--font-heading); color: var(--color-text-primary); text-transform: uppercase; text-decoration: none; display: flex; align-items: center;">
        {%- liquid
          assign logo_img = section.settings.logo
          if logo_img != blank
            assign logo_src = logo_img | image_url: width: 440
          else
            assign logo_src = 'seedream-5.0-pro_a_help_me_recrete_this.jpeg' | asset_url
          endif
        -%}
        <img src="{{ logo_src }}" alt="{{ shop.name | escape }}" width="220" height="60" style="object-fit: contain; max-height: 65px; width: auto;">
      </a>
    </div>

    {%- comment -%} Desktop Navigation Menu with Multi-level Dropdowns matching reference screenshot {%- endcomment -%}
    <nav class="header__nav desktop-only" role="navigation" aria-label="Main Navigation">
      <ul class="flex items-center gap-lg">
        
        {%- comment -%} SHOP Dropdown {%- endcomment -%}
        <li style="position: relative;" class="nav-item">
          <a href="{{ routes.all_products_collection_url }}" class="nav-link" style="font-size: 0.85rem; font-weight: var(--font-weight-bold); text-transform: uppercase; letter-spacing: 0.08em; padding: 1.5rem 0; color: var(--color-text-primary); display: inline-flex; align-items: center; gap: 0.35rem; transition: color var(--transition-fast);">
            <span>SHOP</span>
            {% render 'icon-chevron' %}
          </a>
          <ul class="dropdown-menu" style="position: absolute; top: 100%; left: -10px; min-width: 230px; background: #0D1B2A; border: 1px solid var(--color-border-dark); border-radius: var(--radius-sm); box-shadow: var(--shadow-lg); padding: 0.75rem 0; opacity: 0; visibility: hidden; transition: all var(--transition-fast); z-index: 100;">
            <li><a href="{{ routes.all_products_collection_url }}" class="dropdown-link">All Products</a></li>
            <li><a href="{{ routes.all_products_collection_url }}" class="dropdown-link">Premium Tees</a></li>
            <li><a href="{{ routes.all_products_collection_url }}" class="dropdown-link">Hoodies &amp; Sweatshirts</a></li>
            <li><a href="{{ routes.all_products_collection_url }}" class="dropdown-link">Hats &amp; Accessories</a></li>
            <li><a href="{{ routes.all_products_collection_url }}" class="dropdown-link">Home &amp; Decor</a></li>
            <li><a href="{{ routes.all_products_collection_url }}" class="dropdown-link">Gift Cards</a></li>
          </ul>
        </li>

        {%- comment -%} COLLECTIONS Dropdown {%- endcomment -%}
        <li style="position: relative;" class="nav-item">
          <a href="{{ routes.collections_url }}" class="nav-link" style="font-size: 0.85rem; font-weight: var(--font-weight-bold); text-transform: uppercase; letter-spacing: 0.08em; padding: 1.5rem 0; color: var(--color-text-primary); display: inline-flex; align-items: center; gap: 0.35rem; transition: color var(--transition-fast);">
            <span>COLLECTIONS</span>
            {% render 'icon-chevron' %}
          </a>
          <ul class="dropdown-menu" style="position: absolute; top: 100%; left: -10px; min-width: 230px; background: #0D1B2A; border: 1px solid var(--color-border-dark); border-radius: var(--radius-sm); box-shadow: var(--shadow-lg); padding: 0.75rem 0; opacity: 0; visibility: hidden; transition: all var(--transition-fast); z-index: 100;">
            <li><a href="{{ routes.all_products_collection_url }}" class="dropdown-link">Collection A</a></li>
            <li><a href="{{ routes.all_products_collection_url }}" class="dropdown-link">Collection B</a></li>
            <li><a href="{{ routes.all_products_collection_url }}" class="dropdown-link">Series 01</a></li>
            <li><a href="{{ routes.all_products_collection_url }}" class="dropdown-link">Series 02</a></li>
            <li><a href="{{ routes.all_products_collection_url }}" class="dropdown-link">Patriot Essentials</a></li>
            <li><a href="{{ routes.all_products_collection_url }}" class="dropdown-link">Limited Editions</a></li>
          </ul>
        </li>

        {%- comment -%} ABOUT Dropdown {%- endcomment -%}
        <li style="position: relative;" class="nav-item">
          <a href="{{ routes.root_url }}pages/about" class="nav-link" style="font-size: 0.85rem; font-weight: var(--font-weight-bold); text-transform: uppercase; letter-spacing: 0.08em; padding: 1.5rem 0; color: var(--color-text-primary); display: inline-flex; align-items: center; gap: 0.35rem; transition: color var(--transition-fast);">
            <span>ABOUT</span>
            {% render 'icon-chevron' %}
          </a>
          <ul class="dropdown-menu" style="position: absolute; top: 100%; left: -10px; min-width: 230px; background: #0D1B2A; border: 1px solid var(--color-border-dark); border-radius: var(--radius-sm); box-shadow: var(--shadow-lg); padding: 0.75rem 0; opacity: 0; visibility: hidden; transition: all var(--transition-fast); z-index: 100;">
            <li><a href="{{ routes.root_url }}pages/our-story" class="dropdown-link">Our Story</a></li>
            <li><a href="{{ routes.root_url }}pages/our-mission" class="dropdown-link">Our Mission</a></li>
            <li><a href="{{ routes.root_url }}pages/craftsmanship" class="dropdown-link">Craftsmanship</a></li>
            <li><a href="{{ routes.root_url }}pages/reviews" class="dropdown-link">Reviews</a></li>
            <li><a href="{{ routes.root_url }}pages/wholesale" class="dropdown-link">Wholesale</a></li>
            <li><a href="{{ routes.root_url }}pages/careers" class="dropdown-link">Careers</a></li>
          </ul>
        </li>

        {%- comment -%} JOURNAL {%- endcomment -%}
        <li class="nav-item">
          <a href="{{ routes.root_url }}blogs/news" class="nav-link" style="font-size: 0.85rem; font-weight: var(--font-weight-bold); text-transform: uppercase; letter-spacing: 0.08em; padding: 1.5rem 0; color: var(--color-text-primary); display: inline-flex; align-items: center; transition: color var(--transition-fast);">
            <span>JOURNAL</span>
          </a>
        </li>

        {%- comment -%} CONTACT {%- endcomment -%}
        <li class="nav-item">
          <a href="{{ routes.root_url }}pages/contact" class="nav-link" style="font-size: 0.85rem; font-weight: var(--font-weight-bold); text-transform: uppercase; letter-spacing: 0.08em; padding: 1.5rem 0; color: var(--color-text-primary); display: inline-flex; align-items: center; transition: color var(--transition-fast);">
            <span>CONTACT</span>
          </a>
        </li>

      </ul>
    </nav>

    {%- comment -%} Action Icons (Search, Customer Account, Cart) {%- endcomment -%}
    <div class="header__icons flex items-center gap-xs">
      {%- comment -%} Search Button {%- endcomment -%}
      <button type="button" class="icon-btn" data-drawer-trigger="search-drawer" aria-label="{{ 'general.accessibility.search' | t }}">
        {% render 'icon-search' %}
      </button>

      {%- comment -%} Customer Account {%- endcomment -%}
      <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="icon-btn" aria-label="Customer Account">
        {% render 'icon-user' %}
      </a>

      {%- comment -%} Cart Trigger with Red Count Badge {%- endcomment -%}
      <button type="button" class="icon-btn" data-drawer-trigger="cart-drawer" aria-label="{{ 'general.accessibility.cart' | t }}" style="position: relative;">
        {% render 'icon-cart' %}
        <span data-cart-count style="position: absolute; top: 2px; right: 2px; background-color: var(--color-cta-bg); color: #FFFFFF; font-size: 0.7rem; font-weight: var(--font-weight-bold); width: 18px; height: 18px; border-radius: var(--radius-full); display: {%- if cart.item_count > 0 %}inline-flex{% else %}none{% endif %}; align-items: center; justify-content: center; border: 1.5px solid var(--color-bg-primary);">
          {{ cart.item_count }}
        </span>
      </button>
    </div>

  </div>
</header>

