    </nav>
  </div>
</div>

{%- comment -%} Predictive Search Modal Drawer {%- endcomment -%}
<div id="search-drawer" class="drawer" aria-hidden="true">
  <div class="drawer__header">
    <h3 style="font-size: 1.25rem; font-family: var(--font-heading); text-transform: uppercase;">Search Store</h3>
    <button type="button" class="icon-btn" data-drawer-close aria-label="Close search">
      {% render 'icon-close' %}
    </button>
  </div>
  <div class="drawer__body">
    <form action="{{ routes.search_url }}" method="get" role="search">
      <div class="field">
        <label for="SearchInput" class="field__label">{{ 'general.search.placeholder' | t }}</label>
        <input id="SearchInput" type="search" name="q" class="field__input" placeholder="{{ 'general.search.placeholder' | t }}" autocomplete="off" required>
      </div>
      <button type="submit" class="btn btn--primary btn--full" style="margin-top: 1rem;">
        {{ 'general.search.submit' | t }}
      </button>
    </form>
  </div>
</div>

<style>
  .dropdown-link {
    display: block;
    padding: 0.6rem 1.25rem;
    font-size: 0.85rem;
    font-weight: var(--font-weight-medium);
    color: #FFFFFF !important;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }
  .dropdown-link:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: var(--color-accent-gold) !important;
  }
  @media (max-width: 990px) {
    .desktop-only { display: none !important; }
    .mobile-only { display: inline-flex !important; }
  }
  .nav-item:hover .dropdown-menu {
    opacity: 1 !important;
    visibility: visible !important;
    transform: translateY(0);
  }
  .nav-link:hover {
    color: var(--color-cta-bg) !important;
  }
</style>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
