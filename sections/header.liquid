          <span style="font-size: 1.05rem; font-weight: var(--font-weight-bold); text-transform: uppercase; display: block; margin-bottom: 0.5rem; color: var(--color-accent-gold);">SHOP</span>
          <ul style="padding-left: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem;">
            <li><a href="{{ routes.all_products_collection_url }}" style="font-size: 0.9rem; text-transform: uppercase;">All Products</a></li>
            <li><a href="{{ routes.all_products_collection_url }}" style="font-size: 0.9rem; text-transform: uppercase;">Premium Tees</a></li>
            <li><a href="{{ routes.all_products_collection_url }}" style="font-size: 0.9rem; text-transform: uppercase;">Hoodies &amp; Sweatshirts</a></li>
            <li><a href="{{ routes.all_products_collection_url }}" style="font-size: 0.9rem; text-transform: uppercase;">Hats &amp; Accessories</a></li>
            <li><a href="{{ routes.all_products_collection_url }}" style="font-size: 0.9rem; text-transform: uppercase;">Home &amp; Decor</a></li>
            <li><a href="{{ routes.all_products_collection_url }}" style="font-size: 0.9rem; text-transform: uppercase;">Gift Cards</a></li>
          </ul>
        </li>

        <li style="border-bottom: 1px solid var(--color-border); padding-bottom: 0.75rem;">
          <span style="font-size: 1.05rem; font-weight: var(--font-weight-bold); text-transform: uppercase; display: block; margin-bottom: 0.5rem; color: var(--color-accent-gold);">COLLECTIONS</span>
          <ul style="padding-left: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem;">
            <li><a href="{{ routes.all_products_collection_url }}" style="font-size: 0.9rem; text-transform: uppercase;">Collection A</a></li>
            <li><a href="{{ routes.all_products_collection_url }}" style="font-size: 0.9rem; text-transform: uppercase;">Collection B</a></li>
            <li><a href="{{ routes.all_products_collection_url }}" style="font-size: 0.9rem; text-transform: uppercase;">Series 01</a></li>
            <li><a href="{{ routes.all_products_collection_url }}" style="font-size: 0.9rem; text-transform: uppercase;">Series 02</a></li>
            <li><a href="{{ routes.all_products_collection_url }}" style="font-size: 0.9rem; text-transform: uppercase;">Patriot Essentials</a></li>
            <li><a href="{{ routes.all_products_collection_url }}" style="font-size: 0.9rem; text-transform: uppercase;">Limited Editions</a></li>
          </ul>
        </li>

        <li style="border-bottom: 1px solid var(--color-border); padding-bottom: 0.75rem;">
          <span style="font-size: 1.05rem; font-weight: var(--font-weight-bold); text-transform: uppercase; display: block; margin-bottom: 0.5rem; color: var(--color-accent-gold);">ABOUT</span>
          <ul style="padding-left: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem;">
            <li><a href="{{ routes.root_url }}pages/our-story" style="font-size: 0.9rem; text-transform: uppercase;">Our Story</a></li>
            <li><a href="{{ routes.root_url }}pages/our-mission" style="font-size: 0.9rem; text-transform: uppercase;">Our Mission</a></li>
            <li><a href="{{ routes.root_url }}pages/craftsmanship" style="font-size: 0.9rem; text-transform: uppercase;">Craftsmanship</a></li>
            <li><a href="{{ routes.root_url }}pages/reviews" style="font-size: 0.9rem; text-transform: uppercase;">Reviews</a></li>
            <li><a href="{{ routes.root_url }}pages/wholesale" style="font-size: 0.9rem; text-transform: uppercase;">Wholesale</a></li>
            <li><a href="{{ routes.root_url }}pages/careers" style="font-size: 0.9rem; text-transform: uppercase;">Careers</a></li>
          </ul>
        </li>

        <li style="border-bottom: 1px solid var(--color-border); padding-bottom: 0.75rem;">
          <a href="{{ routes.root_url }}blogs/news" style="font-size: 1.05rem; font-weight: var(--font-weight-bold); text-transform: uppercase;">JOURNAL</a>
        </li>
        <li style="border-bottom: 1px solid var(--color-border); padding-bottom: 0.75rem;">
          <a href="{{ routes.root_url }}pages/contact" style="font-size: 1.05rem; font-weight: var(--font-weight-bold); text-transform: uppercase;">CONTACT</a>
