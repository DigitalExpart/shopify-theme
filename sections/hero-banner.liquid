{%- comment -%}
  Hero Banner Section - The Amendment Company
{%- endcomment -%}

<div class="hero-banner" style="position: relative; width: 100%; min-height: {{ section.settings.desktop_height }}px; display: flex; align-items: center; justify-content: {{ section.settings.text_alignment }}; overflow: hidden; background-color: var(--color-text-primary);">
  {%- if section.settings.image != blank -%}
    <img
      src="{{ section.settings.image | image_url: width: 2000 }}"
      alt="{{ section.settings.heading | escape }}"
      loading="eager"
      width="2000"
      height="1000"
      style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;"
    >
  {%- else -%}
    <div style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(13,27,42,0.92) 0%, rgba(27,38,59,0.85) 50%, rgba(138,30,30,0.4) 100%);"></div>
  {%- endif -%}

  <div style="position: absolute; inset: 0; background-color: rgba(13, 27, 42, {{ section.settings.overlay_opacity | divided_by: 100.0 }});"></div>

  <div class="page-width" style="position: relative; z-index: 2; padding-top: 5rem; padding-bottom: 5rem; color: #FFFFFF; max-width: 780px; text-align: {{ section.settings.text_alignment }};">
    {%- if section.settings.subheading != blank -%}
      <div style="margin-bottom: 0.75rem;">
        <span class="subheading" style="color: var(--color-accent-gold); display: block; font-size: 0.9rem; letter-spacing: 0.2em;">
          {{ section.settings.subheading }}
        </span>
        <span style="color: var(--color-accent-gold); font-size: 0.85rem; letter-spacing: 0.15em; display: block; margin-top: 0.25rem;">★ ★ ★</span>
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 style="color: #FFFFFF; font-size: clamp(2.75rem, 5.5vw, 4.5rem); line-height: 1.1; margin-bottom: 1.25rem; font-family: var(--font-heading); text-transform: uppercase; letter-spacing: -0.02em;">
        {{ section.settings.heading }}
      </h1>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <p style="color: #E2E8F0; font-size: 1.15rem; line-height: 1.6; margin-bottom: 2.25rem; max-width: 620px;">
        {{ section.settings.text }}
      </p>
    {%- endif -%}

    <div class="flex items-center gap-md" style="justify-content: {% if section.settings.text_alignment == 'center' %}center{% elsif section.settings.text_alignment == 'right' %}flex-end{% else %}flex-start{% endif %}; flex-wrap: wrap;">
      {%- if section.settings.button_label_1 != blank -%}
        {% render 'button', label: section.settings.button_label_1, link: section.settings.button_link_1, style: 'primary' %}
      {%- endif -%}

      {%- if section.settings.button_label_2 != blank -%}
        <a href="{{ section.settings.button_link_2 | default: '#' }}" class="btn btn--secondary" style="background-color: var(--color-text-primary); color: #FFFFFF; border: 1px solid var(--color-border-dark);">
          <span>{{ section.settings.button_label_2 }}</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 400,
      "max": 900,
      "step": 50,
      "default": 650,
      "unit": "px",
      "label": "Desktop Height"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 40,
      "unit": "%",
      "label": "Overlay Opacity"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "FAITH. FAMILY. FREEDOM."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WE THE PEOPLE STAND TOGETHER"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Patriotic apparel for those who love this country and the values it was built on."
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary Button Text",
      "default": "EXPLORE COLLECTIONS"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
