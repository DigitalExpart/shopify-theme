{%- comment -%}
  Brand Pillars Section - The Amendment Company
{%- endcomment -%}

<div class="brand-pillars section-spacing" style="background-color: var(--color-bg-primary);">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div style="text-align: center; margin-bottom: 3rem;">
        <span class="subheading" style="font-size: 0.9rem; letter-spacing: 0.15em;">
          ★ {{ section.settings.heading }} ★
        </span>
      </div>
    {%- endif -%}

    <div class="grid grid--3-col">
      {%- for block in section.blocks -%}
        <div class="pillar-card" style="background: var(--color-bg-secondary); border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--color-border); display: flex; flex-direction: column; position: relative;">
          <div class="media-wrapper media-wrapper--portrait">
            {%- liquid
              assign pillar_img = block.settings.image
              if pillar_img != blank
                assign pillar_src = pillar_img | image_url: width: 800
              else
                case forloop.index
                  when 1
                    assign pillar_src = 'seedream-5.0-pro_a_help_me_recrete_this.jpeg' | asset_url
                  when 2
                    assign pillar_src = 'seedream-5.0-pro_a_help_replicate_this_.jpeg' | asset_url
                  else
                    assign pillar_src = 'seedream-5.0-pro_a_help_replicate_this_ (2).jpeg' | asset_url
                endcase
              endif
            -%}
            <img src="{{ pillar_src }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="800" height="1000">
            <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(13,27,42,0.92) 0%, rgba(13,27,42,0.3) 60%);"></div>
          </div>
          <div style="position: absolute; inset: 0; padding: 2rem; display: flex; flex-direction: column; justify-content: flex-end; color: #FFFFFF;">
            <h3 style="font-size: 1.5rem; margin-bottom: 0.5rem; font-family: var(--font-heading); color: #FFFFFF; text-transform: uppercase; letter-spacing: 0.05em;">
              {{ block.settings.title }}
            </h3>
            <p style="font-size: 0.9rem; color: #E2E8F0; margin-bottom: 1.25rem; line-height: 1.5;">
              {{ block.settings.description }}
            </p>
            {%- if block.settings.button_label != blank -%}
              <a href="{{ block.settings.button_link | default: '#' }}" style="font-size: 0.85rem; font-weight: var(--font-weight-bold); color: var(--color-accent-gold); text-transform: uppercase; letter-spacing: 0.08em; display: inline-flex; align-items: center; gap: 0.4rem;">
                <span>{{ block.settings.button_label }}</span> &rarr;
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Brand Pillars",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "OUR BRAND PILLARS"
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "HERITAGE"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Rooted in the ideals that built our nation. We honor the past to inspire the future."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "LEARN MORE"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Pillars",
      "blocks": [
        { "type": "pillar", "settings": { "title": "HERITAGE", "description": "Rooted in the ideals that built our nation. We honor the past to inspire the future." } },
        { "type": "pillar", "settings": { "title": "QUALITY", "description": "Premium fabrics, built to last, crafted with integrity and detailed with purpose." } },
        { "type": "pillar", "settings": { "title": "COMMUNITY", "description": "We stand with patriots who believe in freedom, family, and each other." } }
      ]
    }
  ]
}
{% endschema %}
