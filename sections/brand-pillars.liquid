{%- comment -%}
  Brand Pillars Section - The Amendment Company (1776)
  Recreated to match Image 1 reference: 3 landscape cards with custom background images,
  dark overlay, clean white typography, and gold "LEARN MORE →" link buttons.
{%- endcomment -%}

<div class="brand-pillars" style="background-color: var(--color-bg-primary); padding-top: 3.5rem; padding-bottom: 4rem;">
  <div class="page-width">
    
    {%- comment -%} Section Header ★ OUR BRAND PILLARS ★ {%- endcomment -%}
    {%- if section.settings.heading != blank -%}
      <div style="text-align: center; margin-bottom: 2.25rem;">
        <h2 style="font-family: var(--font-body); color: #0D1B2A; font-size: 1.15rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.15em; display: inline-flex; align-items: center; gap: 0.6rem;">
          <span style="color: #C5A059; font-size: 0.95rem;">★</span>
          <span>{{ section.settings.heading }}</span>
          <span style="color: #C5A059; font-size: 0.95rem;">★</span>
        </h2>
      </div>
    {%- endif -%}

    {%- comment -%} 3-Column Landscape Grid {%- endcomment -%}
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;">
      {%- for block in section.blocks -%}
        <div class="pillar-card" style="position: relative; height: 280px; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 18px rgba(0,0,0,0.18); transition: transform 0.3s ease, box-shadow 0.3s ease;">
          
          {%- liquid
            assign pillar_img = block.settings.image
            if pillar_img != blank
              assign pillar_src = pillar_img | image_url: width: 900
            else
              case forloop.index
                when 1
                  assign pillar_src = 'uni-1.1_a_help_replicate_this_.png' | asset_url
                when 2
                  assign pillar_src = 'uni-1.1_a_remove_the_text_on_t.png' | asset_url
                else
                  assign pillar_src = 'uni-1.1_a_replicate_this_image.png' | asset_url
              endcase
            endif
          -%}
          
          <img
            src="{{ pillar_src }}"
            alt="{{ block.settings.title | escape }}"
            loading="lazy"
            width="900"
            height="560"
            style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;"
          >

          {%- comment -%} Dark Gradient Overlay for Crisp White Text Readability {%- endcomment -%}
          <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.45) 55%, rgba(0, 0, 0, 0.12) 100%);"></div>

          {%- comment -%} Card Content {%- endcomment -%}
          <div style="position: absolute; inset: 0; padding: 1.6rem 1.6rem 1.4rem 1.6rem; display: flex; flex-direction: column; justify-content: flex-end; color: #FFFFFF;">
            <h3 style="font-family: var(--font-heading); color: #FFFFFF; font-size: 1.4rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.4rem; line-height: 1.1;">
              {{ block.settings.title }}
            </h3>
            <p style="font-size: 0.84rem; color: #E2E8F0; margin-bottom: 0.85rem; line-height: 1.45; font-weight: 400; max-width: 95%;">
              {{ block.settings.description }}
            </p>
            {%- if block.settings.button_label != blank -%}
              {%- assign pillar_link = block.settings.button_link -%}
              {%- if pillar_link == blank or pillar_link == '#' -%}{%- assign pillar_link = routes.root_url | append: 'pages/our-story' -%}{%- endif -%}
              <a href="{{ pillar_link }}" style="font-size: 0.78rem; font-weight: 800; color: #C5A059; text-transform: uppercase; letter-spacing: 0.08em; display: inline-flex; align-items: center; gap: 0.35rem; text-decoration: none; transition: color 0.2s;" onmouseenter="this.style.color='#FFFFFF'" onmouseleave="this.style.color='#C5A059'">
                <span>{{ block.settings.button_label }}</span> &rarr;
              </a>
            {%- endif -%}
          </div>

        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

<style>
  .pillar-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.25) !important;
  }
  @media (max-width: 900px) {
    .brand-pillars .page-width > div:last-child {
      grid-template-columns: 1fr !important;
      gap: 1.25rem !important;
    }
    .pillar-card {
      height: 250px !important;
    }
  }
</style>

{% schema %}
{
  "name": "Brand Pillars",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "OUR BRAND PILLARS"
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "HERITAGE"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Rooted in the ideals that built our nation. We honor the past to inspire the future."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "LEARN MORE"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Pillars",
      "blocks": [
        { "type": "pillar", "settings": { "title": "HERITAGE", "description": "Rooted in the ideals that built our nation. We honor the past to inspire the future." } },
        { "type": "pillar", "settings": { "title": "QUALITY", "description": "Premium fabrics, built to last, crafted with integrity and detailed with purpose." } },
        { "type": "pillar", "settings": { "title": "COMMUNITY", "description": "We stand with patriots who believe in freedom, family, and each other." } }
      ]
    }
  ]
}
{% endschema %}
