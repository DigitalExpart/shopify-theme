{%- comment -%}
  Split Section: Built With Purpose & Stay Inspired Newsletter - The Amendment Company
{%- endcomment -%}

<div class="brand-story section-spacing" style="background-color: var(--color-bg-primary);">
  <div class="page-width">
    <div class="grid grid--2-col gap-lg items-stretch">

      {%- comment -%} Left Card: Built With Purpose (Navy Box) {%- endcomment -%}
      <div style="background-color: var(--color-text-primary); color: #FFFFFF; border-radius: var(--radius-md); padding: 3rem 2.5rem; display: flex; flex-direction: column; justify-content: space-between; border: 1px solid var(--color-border-dark);">
        <div>
          <span class="subheading" style="color: var(--color-accent-gold); font-size: 0.85rem; letter-spacing: 0.15em;">
            OUR MISSION
          </span>
          <h2 style="color: #FFFFFF; font-size: clamp(1.85rem, 3vw, 2.5rem); margin-top: 0.5rem; margin-bottom: 1.25rem; font-family: var(--font-heading); text-transform: uppercase;">
            BUILT WITH PURPOSE
          </h2>
          <p style="color: #CBD5E1; font-size: 1.05rem; line-height: 1.7; margin-bottom: 2rem;">
            The Amendment Company was founded on a simple belief—that freedom is worth defending and honoring every day. We create apparel that sparks conversation, strengthens community, and reminds us of the values we stand for.
          </p>
        </div>

        <div style="border-top: 1px solid rgba(255,255,255,0.15); padding-top: 1.25rem; font-style: italic; font-family: var(--font-heading);">
          <span style="font-size: 1.2rem; color: var(--color-accent-gold); display: block;">Founder Name</span>
          <span style="font-size: 0.75rem; color: #94A3B8; text-transform: uppercase; letter-spacing: 0.15em; font-style: normal;">FOUNDER &amp; PATRIOT</span>
        </div>
      </div>

      {%- comment -%} Right Card: Stay Inspired Newsletter (Cream Box) {%- endcomment -%}
      <div style="background-color: var(--color-bg-secondary); color: var(--color-text-primary); border-radius: var(--radius-md); padding: 3rem 2.5rem; border: 1px solid var(--color-border); display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <span class="subheading" style="font-size: 0.85rem; letter-spacing: 0.15em;">
            NEWSLETTER
          </span>
          <h2 style="font-size: clamp(1.85rem, 3vw, 2.5rem); margin-top: 0.5rem; margin-bottom: 1rem; font-family: var(--font-heading); text-transform: uppercase;">
            STAY INSPIRED ★
          </h2>
          <p style="color: var(--color-text-secondary); font-size: 1.05rem; line-height: 1.6; margin-bottom: 1.75rem;">
            Join our community for new arrivals, exclusive offers, and stories that matter.
          </p>

          {% form 'customer', class: 'stay-inspired-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="flex gap-sm" style="flex-wrap: wrap;">
              <input
                type="email"
                name="contact[email]"
                class="field__input"
                placeholder="Enter your email address"
                required
                style="flex: 1; min-width: 220px;"
              >
              <button type="submit" class="btn btn--primary">
                JOIN NOW
              </button>
            </div>
          {% endform %}
        </div>

        <div class="flex items-center gap-md" style="margin-top: 2rem; border-top: 1px solid var(--color-border); padding-top: 1.25rem; font-size: 0.85rem; color: var(--color-text-secondary); flex-wrap: wrap;">
          <span class="flex items-center gap-xs">
            <span style="color: var(--color-success); font-weight: bold;">✓</span> Exclusive Offers
          </span>
          <span class="flex items-center gap-xs">
            <span style="color: var(--color-success); font-weight: bold;">✓</span> New Releases
          </span>
          <span class="flex items-center gap-xs">
            <span style="color: var(--color-success); font-weight: bold;">✓</span> Patriot Stories
          </span>
        </div>
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Brand Story Split",
  "settings": []
}
{% endschema %}
