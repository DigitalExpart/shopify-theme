{%- comment -%}
  Split Section 1: Built With Purpose (Left) & Stay Inspired Newsletter (Right)
  Exact reference replica: Full-width edge-to-edge 50/50 split banner.
{%- endcomment -%}

<div class="brand-story-split" style="width: 100%; display: grid; grid-template-columns: 1fr 1fr; background-color: var(--color-bg-primary); overflow: hidden;">
  
  {%- comment -%} Left Column: Built With Purpose (Image + Dark Navy Overlay + Content) {%- endcomment -%}
  <div style="position: relative; min-height: 340px; display: flex; align-items: center; justify-content: flex-end; padding: 3rem; background-color: #0D1B2A; color: #FFFFFF; overflow: hidden;">
    {%- liquid
      assign story_img = section.settings.image
      if story_img != blank
        assign story_src = story_img | image_url: width: 1200
      else
        assign story_src = 'seedream-5.0-pro_a_help_replicate_this_ (2).jpeg' | asset_url
      endif
    -%}
    <img
      src="{{ story_src }}"
      alt="Built With Purpose"
      loading="lazy"
      width="1200"
      height="700"
      style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: left center;"
    >

    {%- comment -%} Gradient overlay: image on left, dark navy text block on right {%- endcomment -%}
    <div style="position: absolute; inset: 0; background: linear-gradient(to right, rgba(13, 27, 42, 0.2) 0%, rgba(13, 27, 42, 0.85) 40%, rgba(13, 27, 42, 0.98) 100%);"></div>

    <div style="position: relative; z-index: 2; max-width: 440px; text-align: left;">
      <h2 style="font-family: 'Oswald', 'Impact', sans-serif; color: #FFFFFF; font-size: 1.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 0.85rem; line-height: 1.1;">
        BUILT WITH PURPOSE
      </h2>
      <p style="color: #CBD5E1; font-size: 0.88rem; line-height: 1.55; margin-bottom: 1.25rem;">
        The Amendment Company was founded on a simple belief—that freedom is worth defending and honoring every day. We create apparel that sparks conversation, strengthens community, and reminds us of the values we stand for.
      </p>
      <div>
        <span style="font-family: 'Playfair Display', serif; font-style: italic; color: #C5A059; font-size: 1.25rem; display: block; line-height: 1.2;">
          Founder Name
        </span>
        <span style="color: #94A3B8; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.15em; text-transform: uppercase; display: block; margin-top: 0.2rem;">
          FOUNDER &amp; PATRIOT
        </span>
      </div>
    </div>
  </div>

  {%- comment -%} Right Column: Stay Inspired Newsletter (Parchment Background) {%- endcomment -%}
  <div style="position: relative; min-height: 340px; display: flex; align-items: center; justify-content: flex-start; padding: 3rem; background-color: #FAF8F5; color: #0D1B2A;">
    <div style="max-width: 460px; text-align: left; width: 100%;">
      <h2 style="font-family: 'Oswald', 'Impact', sans-serif; color: #0D1B2A; font-size: 1.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem; line-height: 1.1;">
        <span>STAY INSPIRED</span>
        <span style="color: #C5A059; font-size: 1.1rem;">★</span>
      </h2>
      <p style="color: #475569; font-size: 0.88rem; line-height: 1.5; margin-bottom: 1.25rem;">
        Join our community for new arrivals, exclusive offers, and stories that matter.
      </p>

      {% form 'customer', class: 'stay-inspired-inline-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div style="display: flex; width: 100%; max-width: 420px; border-radius: 2px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.06); margin-bottom: 1.25rem;">
          <input
            type="email"
            name="contact[email]"
            placeholder="Enter your email address"
            required
            style="flex: 1; padding: 0.65rem 1rem; font-size: 0.85rem; background: #FFFFFF; color: #0D1B2A; border: 1px solid #CBD5E1; border-right: none; outline: none;"
          >
          <button type="submit" style="background-color: #A31C1C; color: #FFFFFF; font-weight: 800; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.65rem 1.4rem; border: none; cursor: pointer; transition: background 0.2s;" onmouseenter="this.style.backgroundColor='#8B1E1E'" onmouseleave="this.style.backgroundColor='#A31C1C'">
            JOIN NOW
          </button>
        </div>
      {% endform %}

      {%- comment -%} 3 Red Shield Badge Icons {%- endcomment -%}
      <div style="display: flex; align-items: center; gap: 1.25rem; font-size: 0.78rem; font-weight: 700; color: #334155; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 0.4rem;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" fill="#A31C1C"/><path d="M8 12l3 3 5-5" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Exclusive Offers</span>
        </div>
        <div style="display: flex; align-items: center; gap: 0.4rem;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" fill="#A31C1C"/><path d="M8 12l3 3 5-5" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>New Releases</span>
        </div>
        <div style="display: flex; align-items: center; gap: 0.4rem;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" fill="#A31C1C"/><path d="M8 12l3 3 5-5" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Patriot Stories</span>
        </div>
      </div>

    </div>
  </div>

</div>

<style>
  @media (max-width: 900px) {
    .brand-story-split {
      grid-template-columns: 1fr !important;
    }
  }
</style>

{% schema %}
{
  "name": "Brand Story Split",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Left Card Background Image"
    }
  ],
  "presets": [
    {
      "name": "Brand Story Split"
    }
  ]
}
{% endschema %}
