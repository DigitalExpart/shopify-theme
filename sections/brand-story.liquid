{%- comment -%}
  Brand Story Split Layout Section
{%- endcomment -%}

<div class="brand-story section-spacing" style="background-color: var(--color-bg-tertiary); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);">
  <div class="page-width">
    <div class="grid grid--2-col items-center gap-2xl">

      <div class="media-wrapper media-wrapper--portrait" style="border-radius: var(--radius-md);">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}" loading="lazy" width="1200" height="1500">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div style="padding: 1rem 0;">
        {%- if section.settings.subheading != blank -%}
          <span class="subheading">{{ section.settings.subheading }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 style="font-size: clamp(2rem, 3.5vw, 3rem); margin-bottom: 1.5rem;">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div style="font-size: 1.05rem; line-height: 1.7; color: var(--color-text-secondary); margin-bottom: 2rem;">
            {{ section.settings.text }}
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div>
            {% render 'button', label: section.settings.button_label, link: section.settings.button_link, style: 'primary' %}
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Brand Story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Story Image"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our Heritage & Purpose"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for Those Who Appreciate Pure Craftsmanship"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Story Narrative",
      "default": "<p>Founded on principles of uncompromising precision and minimalist design, our workshop brings together master artisans and innovative engineering. Each piece is designed to tell a story of endurance, elegance, and intentional living.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Read Our Full Story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Brand Story"
    }
  ]
}
{% endschema %}
