{%- comment -%}
  Trust Badges Section - The Amendment Company
{%- endcomment -%}

<div class="trust-badges section-spacing" style="background-color: var(--color-bg-tertiary); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); padding-top: 2rem; padding-bottom: 2rem;">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div style="text-align: center; margin-bottom: 2rem;">
        <span class="subheading">{{ section.settings.subheading }}</span>
        <h2 style="font-size: 1.85rem;">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="grid grid--4-col">
      {%- for block in section.blocks -%}
        {% render 'icon-card', icon_name: block.settings.icon, title: block.settings.title, subtitle: block.settings.subtitle %}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Trust Badges",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "badge_card",
      "name": "Trust Badge Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Shipping Truck" },
            { "value": "shield", "label": "Security Shield" },
            { "value": "refresh", "label": "Returns Refresh" },
            { "value": "star", "label": "Star Accent" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "AMERICAN OWNED"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Designed & printed in the USA"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Badges",
      "blocks": [
        { "type": "badge_card", "settings": { "icon": "star", "title": "AMERICAN OWNED", "subtitle": "Designed & printed in the USA" } },
        { "type": "badge_card", "settings": { "icon": "shield", "title": "QUALITY CRAFTSMANSHIP", "subtitle": "Premium materials & attention to detail" } },
        { "type": "badge_card", "settings": { "icon": "truck", "title": "RELIABLE SHIPPING", "subtitle": "Fast, secure & trackable" } },
        { "type": "badge_card", "settings": { "icon": "star", "title": "PURPOSE DRIVEN", "subtitle": "Apparel with meaning that gives back" } }
      ]
    }
  ]
}
{% endschema %}
