{%- comment -%}
  Global Footer Section - The Amendment Company (1776)
  Recreated to match client's exact reference screenshot
{%- endcomment -%}

<footer class="footer" style="background-color: #0D1B2A; color: #FAF8F5; padding-top: 3.5rem; padding-bottom: 2rem; margin-top: auto; border-top: 2px solid var(--color-accent-gold);">
  <div class="page-width">
    
    {%- comment -%} Main Footer Grid (6 Columns) {%- endcomment -%}
    <div style="display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr 1fr 1.6fr; gap: 2rem; margin-bottom: 3rem; align-items: start;">

      {%- comment -%} Column 1: Brand Info & Social Icons {%- endcomment -%}
      <div>
        <div style="margin-bottom: 1rem;">
          <a href="{{ routes.root_url }}">
            <img src="{{ 'a_replicte_this_image_.png' | asset_url }}" alt="The Amendment Company 1776" width="200" height="60" style="object-fit: contain; max-height: 60px;">
          </a>
        </div>
        <p style="color: #CBD5E1; font-size: 0.82rem; line-height: 1.6; margin-bottom: 1.25rem; max-width: 240px;">
          {{ section.settings.brand_description | default: 'Constitutionally inspired apparel, for patriots who value freedom, faith, and family.' }}
        </p>
        <div class="flex items-center gap-xs" style="color: #FFFFFF;">
          <a href="#" aria-label="Facebook" style="color: #FFFFFF; display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; background: rgba(255,255,255,0.1); transition: background 0.2s;" onmouseenter="this.style.background='var(--color-cta-bg)'" onmouseleave="this.style.background='rgba(255,255,255,0.1)'">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
          </a>
          <a href="#" aria-label="Instagram" style="color: #FFFFFF; display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; background: rgba(255,255,255,0.1); transition: background 0.2s;" onmouseenter="this.style.background='var(--color-cta-bg)'" onmouseleave="this.style.background='rgba(255,255,255,0.1)'">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
          <a href="#" aria-label="YouTube" style="color: #FFFFFF; display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; background: rgba(255,255,255,0.1); transition: background 0.2s;" onmouseenter="this.style.background='var(--color-cta-bg)'" onmouseleave="this.style.background='rgba(255,255,255,0.1)'">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02" fill="#0D1B2A"></polygon></svg>
          </a>
          <a href="#" aria-label="Email" style="color: #FFFFFF; display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; background: rgba(255,255,255,0.1); transition: background 0.2s;" onmouseenter="this.style.background='var(--color-cta-bg)'" onmouseleave="this.style.background='rgba(255,255,255,0.1)'">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          </a>
        </div>
      </div>

      {%- comment -%} Column 2: SHOP {%- endcomment -%}
      <div>
        <h4 style="color: var(--color-accent-gold); font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 1rem; font-family: var(--font-body);">
          SHOP
        </h4>
        <ul style="display: flex; flex-direction: column; gap: 0.45rem; font-size: 0.82rem;">
          <li><a href="{{ routes.all_products_collection_url }}" class="footer-link">All Products</a></li>
          <li><a href="{{ routes.collections_url }}/premium-tees" class="footer-link">Premium Tees</a></li>
          <li><a href="{{ routes.collections_url }}/hoodies-sweatshirts" class="footer-link">Hoodies &amp; Sweatshirts</a></li>
          <li><a href="{{ routes.collections_url }}/hats-accessories" class="footer-link">Hats &amp; Accessories</a></li>
          <li><a href="{{ routes.collections_url }}/home-decor" class="footer-link">Home &amp; Decor</a></li>
          <li><a href="{{ routes.all_products_collection_url }}" class="footer-link">Gift Cards</a></li>
        </ul>
      </div>

      {%- comment -%} Column 3: COLLECTIONS {%- endcomment -%}
      <div>
        <h4 style="color: var(--color-accent-gold); font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 1rem; font-family: var(--font-body);">
          COLLECTIONS
        </h4>
        <ul style="display: flex; flex-direction: column; gap: 0.45rem; font-size: 0.82rem;">
          <li><a href="{{ routes.collections_url }}/collection-a" class="footer-link">Collection A</a></li>
          <li><a href="{{ routes.collections_url }}/collection-b" class="footer-link">Collection B</a></li>
          <li><a href="{{ routes.collections_url }}/series-01" class="footer-link">Series 01</a></li>
          <li><a href="{{ routes.collections_url }}/series-02" class="footer-link">Series 02</a></li>
          <li><a href="{{ routes.collections_url }}/patriot-essentials" class="footer-link">Patriot Essentials</a></li>
          <li><a href="{{ routes.collections_url }}/limited-editions" class="footer-link">Limited Editions</a></li>
        </ul>
      </div>

      {%- comment -%} Column 4: ABOUT {%- endcomment -%}
      <div>
        <h4 style="color: var(--color-accent-gold); font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 1rem; font-family: var(--font-body);">
          ABOUT
        </h4>
        <ul style="display: flex; flex-direction: column; gap: 0.45rem; font-size: 0.82rem;">
          <li><a href="{{ routes.root_url }}pages/our-story" class="footer-link">Our Story</a></li>
          <li><a href="{{ routes.root_url }}pages/our-mission" class="footer-link">Our Mission</a></li>
          <li><a href="{{ routes.root_url }}pages/craftsmanship" class="footer-link">Craftsmanship</a></li>
          <li><a href="{{ routes.root_url }}pages/reviews" class="footer-link">Reviews</a></li>
          <li><a href="{{ routes.root_url }}pages/wholesale" class="footer-link">Wholesale</a></li>
          <li><a href="{{ routes.root_url }}pages/careers" class="footer-link">Careers</a></li>
        </ul>
      </div>

      {%- comment -%} Column 5: HELP {%- endcomment -%}
      <div>
        <h4 style="color: var(--color-accent-gold); font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 1rem; font-family: var(--font-body);">
          HELP
        </h4>
        <ul style="display: flex; flex-direction: column; gap: 0.45rem; font-size: 0.82rem;">
          <li><a href="{{ routes.root_url }}pages/contact" class="footer-link">Contact Us</a></li>
          <li><a href="{{ routes.root_url }}pages/shipping-policy" class="footer-link">Shipping Policy</a></li>
          <li><a href="{{ routes.root_url }}pages/returns-exchanges" class="footer-link">Returns &amp; Exchanges</a></li>
          <li><a href="{{ routes.root_url }}pages/size-guide" class="footer-link">Size Guide</a></li>
          <li><a href="{{ routes.root_url }}pages/faq" class="footer-link">FAQ</a></li>
          <li><a href="{{ routes.root_url }}pages/track-order" class="footer-link">Track Order</a></li>
        </ul>
      </div>

      {%- comment -%} Column 6: JOIN OUR COMMUNITY Newsletter {%- endcomment -%}
      <div>
        <h4 style="color: var(--color-accent-gold); font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.75rem; font-family: var(--font-body);">
          JOIN OUR COMMUNITY
        </h4>
        <p style="color: #94A3B8; font-size: 0.8rem; line-height: 1.5; margin-bottom: 1rem;">
          Sign up for exclusive content, early access, and special offers.
        </p>

        {% form 'customer', class: 'footer-newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div style="display: flex; width: 100%; border-radius: var(--radius-xs); overflow: hidden;">
            <input
              type="email"
              name="contact[email]"
              placeholder="Enter your email"
              required
              style="flex: 1; padding: 0.6rem 0.85rem; font-size: 0.82rem; background: #FFFFFF; color: #0D1B2A; border: none; outline: none;"
            >
            <button type="submit" style="background-color: var(--color-cta-bg); color: #FFFFFF; font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.6rem 1.1rem; border: none; cursor: pointer; transition: background 0.2s;" onmouseenter="this.style.backgroundColor='#8B1E1E'" onmouseleave="this.style.backgroundColor='var(--color-cta-bg)'">
              SUBSCRIBE
            </button>
          </div>
        {% endform %}
      </div>

    </div>

    {%- comment -%} Sub-footer Copyright & Payment Methods {%- endcomment -%}
    <div class="flex-between" style="border-top: 1px solid rgba(255,255,255,0.12); padding-top: 1.5rem; flex-wrap: wrap; gap: 1rem; font-size: 0.78rem; color: #94A3B8;">
      <div>
        &copy; {{ 'now' | date: "%Y" }} The Amendment Company. All Rights Reserved.
      </div>

      {%- comment -%} Payment Badges {%- endcomment -%}
      <div class="flex items-center gap-xs" style="flex-wrap: wrap;">
        <span style="background: #1E293B; color: #FFFFFF; padding: 2px 7px; border-radius: 3px; font-size: 0.7rem; font-weight: bold; border: 1px solid rgba(255,255,255,0.1);">VISA</span>
        <span style="background: #1E293B; color: #FFFFFF; padding: 2px 7px; border-radius: 3px; font-size: 0.7rem; font-weight: bold; border: 1px solid rgba(255,255,255,0.1);">MC</span>
        <span style="background: #1E293B; color: #FFFFFF; padding: 2px 7px; border-radius: 3px; font-size: 0.7rem; font-weight: bold; border: 1px solid rgba(255,255,255,0.1);">AMEX</span>
        <span style="background: #1E293B; color: #FFFFFF; padding: 2px 7px; border-radius: 3px; font-size: 0.7rem; font-weight: bold; border: 1px solid rgba(255,255,255,0.1);">DISC</span>
        <span style="background: #1E293B; color: #FFFFFF; padding: 2px 7px; border-radius: 3px; font-size: 0.7rem; font-weight: bold; border: 1px solid rgba(255,255,255,0.1);">Pay</span>
        <span style="background: #1E293B; color: #FFFFFF; padding: 2px 7px; border-radius: 3px; font-size: 0.7rem; font-weight: bold; border: 1px solid rgba(255,255,255,0.1);">G Pay</span>
        <span style="background: #1E293B; color: #FFFFFF; padding: 2px 7px; border-radius: 3px; font-size: 0.7rem; font-weight: bold; border: 1px solid rgba(255,255,255,0.1);">PayPal</span>
      </div>
    </div>

  </div>
</footer>

<style>
  .footer-link {
    color: #94A3B8 !important;
    transition: color var(--transition-fast);
  }
  .footer-link:hover {
    color: var(--color-accent-gold) !important;
  }
  @media (max-width: 1024px) {
    .footer .page-width > div:first-child {
      grid-template-columns: 1fr 1fr 1fr !important;
    }
  }
  @media (max-width: 640px) {
    .footer .page-width > div:first-child {
      grid-template-columns: 1fr !important;
      gap: 1.5rem !important;
    }
  }
</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Brand Description",
      "default": "Constitutionally inspired apparel, for patriots who value freedom, faith, and family."
    }
  ]
}
{% endschema %}
