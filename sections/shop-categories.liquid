{%- comment -%}
  Shop Categories Grid Section
{%- endcomment -%}

<div class="shop-categories section-spacing" style="background-color: var(--color-bg-primary);">
  <div class="page-width">
    <div class="flex-between" style="margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1rem;">
      <div>
        {%- if section.settings.subheading != blank -%}
          <span class="subheading">{{ section.settings.subheading }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading | default: 'Shop by Category' }}</h2>
      </div>
      {%- if section.settings.view_all_link != blank -%}
        <a href="{{ section.settings.view_all_link }}" class="btn btn--outline btn--sm">
          View All Categories &rarr;
        </a>
      {%- endif -%}
    </div>

    <div class="grid grid--3-col">
      {%- for block in section.blocks -%}
        {% render 'collection-card', collection: block.settings.collection, title: block.settings.title, image: block.settings.image, link: block.settings.link %}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shop Categories",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Curated Selections"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop Categories",
      "blocks": [
        { "type": "category", "settings": { "title": "Timepieces & Leather" } },
        { "type": "category", "settings": { "title": "Signature Apparel" } },
        { "type": "category", "settings": { "title": "Home & Essentials" } }
      ]
    }
  ]
}
{% endschema %}
