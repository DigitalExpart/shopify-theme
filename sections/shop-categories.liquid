{%- comment -%}
  Shop The Lineup Categories Grid Section - The Amendment Company
{%- endcomment -%}

<div class="shop-categories section-spacing" style="background-color: var(--color-bg-primary);">
  <div class="page-width">
    <div style="text-align: center; margin-bottom: 2.5rem;">
      <span class="subheading" style="font-size: 0.9rem; letter-spacing: 0.15em;">
        ★ SHOP THE LINEUP ★
      </span>
    </div>

    <div class="grid grid--4-col gap-md">
      {%- for block in section.blocks -%}
        {% render 'collection-card', collection: block.settings.collection, title: block.settings.title, image: block.settings.image, link: block.settings.link %}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shop Categories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOP THE LINEUP"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title",
          "default": "PREMIUM TEES"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop Categories",
      "blocks": [
        { "type": "category", "settings": { "title": "PREMIUM TEES" } },
        { "type": "category", "settings": { "title": "HOODIES & SWEATSHIRTS" } },
        { "type": "category", "settings": { "title": "HATS & ACCESSORIES" } },
        { "type": "category", "settings": { "title": "HOME & DECOR" } },
        { "type": "category", "settings": { "title": "COLLECTION A" } },
        { "type": "category", "settings": { "title": "COLLECTION B" } },
        { "type": "category", "settings": { "title": "SERIES 01" } }
      ]
    }
  ]
}
{% endschema %}
