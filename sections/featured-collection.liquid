{%- comment -%}
  Featured Products Section - The Amendment Company (1776)
  Recreated to match Image 1 reference: 6-item carousel with dark navy circular arrow buttons and infinite scroll behavior.
{%- endcomment -%}

<div class="featured-products-carousel" style="background-color: var(--color-bg-primary); padding-top: 2.5rem; padding-bottom: 3.5rem; position: relative;">
  <div class="page-width" style="position: relative;">
    
    {%- comment -%} Heading ★ FEATURED PRODUCTS ★ {%- endcomment -%}
    <div style="text-align: center; margin-bottom: 2rem;">
      <h2 style="font-family: var(--font-body); color: #0D1B2A; font-size: 1.1rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.15em; display: inline-flex; align-items: center; gap: 0.5rem;">
        <span style="color: #C5A059; font-size: 0.85rem;">★</span>
        <span>FEATURED PRODUCTS</span>
        <span style="color: #C5A059; font-size: 0.85rem;">★</span>
      </h2>
    </div>

    {%- comment -%} Responsive Circular Dark Navy Arrow Buttons {%- endcomment -%}
    <button
      type="button"
      id="featured-prev-btn"
      aria-label="Previous Products"
      style="position: absolute; left: -16px; top: 58%; transform: translateY(-50%); z-index: 10; width: 40px; height: 40px; border-radius: 50%; background: #0D1B2A; color: #FFFFFF; border: none; display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: 0 3px 10px rgba(0,0,0,0.25); transition: background 0.2s;"
      onmouseenter="this.style.background='#A31C1C'"
      onmouseleave="this.style.background='#0D1B2A'"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>

    <button
      type="button"
      id="featured-next-btn"
      aria-label="Next Products"
      style="position: absolute; right: -16px; top: 58%; transform: translateY(-50%); z-index: 10; width: 40px; height: 40px; border-radius: 50%; background: #0D1B2A; color: #FFFFFF; border: none; display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: 0 3px 10px rgba(0,0,0,0.25); transition: background 0.2s;"
      onmouseenter="this.style.background='#A31C1C'"
      onmouseleave="this.style.background='#0D1B2A'"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>

    {%- comment -%} Horizontal Scrollable Track {%- endcomment -%}
    <div id="featured-products-track" style="display: flex; gap: 1rem; overflow-x: auto; scroll-behavior: smooth; scroll-snap-type: x mandatory; scrollbar-width: none; padding-bottom: 0.5rem;">
      
      {%- comment -%} Product 1: Product X {%- endcomment -%}
      <div style="flex: 0 0 calc(16.666% - 0.85rem); min-width: 170px; scroll-snap-align: start; text-align: left;">
        <div style="border: 1px solid rgba(13,27,42,0.12); border-radius: 6px; padding: 0.75rem; background: #FFFFFF; margin-bottom: 0.6rem; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
          <img src="{{ 'sample-tee.png' | asset_url }}" alt="Product X" width="300" height="360" style="width: 100%; height: 160px; object-fit: contain;">
        </div>
        <h3 style="font-size: 0.82rem; font-weight: 700; color: #0D1B2A; margin: 0 0 0.2rem 0; font-family: var(--font-body);">Product X</h3>
        <div style="display: flex; align-items: center; gap: 0.35rem; font-size: 0.72rem; color: #C5A059; margin-bottom: 0.25rem;">
          <span>★★★★★</span>
          <span style="color: #64748B;">(256)</span>
