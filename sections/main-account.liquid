{%- comment -%}
  Main Customer Account Dashboard Section
{%- endcomment -%}

<div class="main-account page-width section-spacing">
  {% render 'breadcrumbs' %}

  <div class="flex-between" style="margin-bottom: 3rem; flex-wrap: wrap; gap: 1rem; border-bottom: 1px solid var(--color-border); padding-bottom: 1.5rem;">
    <div>
      <h1 style="font-size: 2.25rem;">{{ 'customer.account.title' | t }}</h1>
      <p style="color: var(--color-text-muted);">Welcome back, {{ customer.name }}</p>
    </div>
    <a href="{{ routes.account_logout_url }}" class="btn btn--outline btn--sm">
      {{ 'customer.account.logout' | t }}
    </a>
  </div>

  <div class="grid grid--3-col gap-2xl">
    <div style="grid-column: span 2;">
      <h2 style="font-size: 1.5rem; margin-bottom: 1.5rem;">
        {{ 'customer.account.order_history' | t }}
      </h2>

      {%- paginate customer.orders by 10 -%}
        {%- if customer.orders.size > 0 -%}
          <div style="display: flex; flex-direction: column; gap: 1rem;">
            {%- for order in customer.orders -%}
              <div style="background: var(--color-bg-secondary); border: 1px solid var(--color-border); padding: 1.5rem; border-radius: var(--radius-sm); display: flex; justify-content: space-between; align-items: center;">
                <div>
                  <h4 style="font-size: 1.1rem; margin-bottom: 0.25rem; font-family: var(--font-body);">
                    Order {{ order.name }}
                  </h4>
                  <p style="font-size: 0.85rem; color: var(--color-text-muted); margin: 0;">
                    Placed on {{ order.created_at | date: "%B %d, %Y" }} &bull; {{ order.financial_status_label }}
                  </p>
                </div>
                <div style="text-align: right;">
                  <span style="font-weight: var(--font-weight-bold); font-size: 1.1rem; display: block; margin-bottom: 0.25rem;">
                    {{ order.total_price | money }}
                  </span>
                  <a href="{{ order.customer_url }}" class="btn btn--outline btn--sm">
                    View Details
                  </a>
                </div>
              </div>
            {%- endfor -%}
          </div>
          {% render 'pagination', paginate: paginate %}
        {%- else -%}
          <p style="color: var(--color-text-muted); font-size: 1.05rem;">
            {{ 'customer.account.no_orders' | t }}
          </p>
        {%- endif -%}
      {%- endpaginate -%}
    </div>

    <div style="background: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 2rem; align-self: flex-start;">
      <h3 style="font-size: 1.25rem; margin-bottom: 1rem; font-family: var(--font-heading);">
        Account Details
      </h3>
      <p style="font-weight: var(--font-weight-semibold); margin-bottom: 0.25rem;">{{ customer.name }}</p>
      <p style="color: var(--color-text-muted); font-size: 0.9rem; margin-bottom: 1.5rem;">{{ customer.email }}</p>

      {%- if customer.default_address -%}
        <div style="font-size: 0.9rem; color: var(--color-text-secondary); line-height: 1.6; margin-bottom: 1.5rem;">
          {{ customer.default_address | format_address }}
        </div>
      {%- endif -%}

      <a href="{{ routes.account_addresses_url }}" class="btn btn--outline btn--full btn--sm">
        {{ 'customer.account.view_addresses' | t }} ({{ customer.addresses_count }})
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Main Account",
  "settings": []
}
{% endschema %}
