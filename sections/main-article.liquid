{%- comment -%}
  Main Article Details Section
{%- endcomment -%}

<article class="main-article page-width page-width--narrow section-spacing">
  {% render 'breadcrumbs' %}

  <header style="text-align: center; margin-bottom: 2.5rem;">
    <span class="subheading" style="color: var(--color-accent-gold);">
      {{ article.published_at | date: "%B %d, %Y" }} &bull; {{ article.author }}
    </span>
    <h1 style="font-size: clamp(2.25rem, 4vw, 3.5rem); line-height: 1.2; margin-top: 0.5rem; margin-bottom: 1.5rem;">
      {{ article.title }}
    </h1>
  </header>

  {%- if article.image -%}
    <div class="media-wrapper media-wrapper--landscape" style="border-radius: var(--radius-md); margin-bottom: 2.5rem;">
      <img src="{{ article.image | image_url: width: 1400 }}" alt="{{ article.title | escape }}" width="1400" height="933" loading="eager">
    </div>
  {%- endif -%}

  <div class="article-content" style="font-size: 1.1rem; line-height: 1.8; color: var(--color-text-secondary);">
    {{ article.content }}
  </div>

  <footer style="margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border); flex-between">
    <a href="{{ blog.url }}" class="btn btn--outline btn--sm">
      &larr; Back to {{ blog.title }}
    </a>
  </footer>
</article>

{% schema %}
{
  "name": "Main Article",
  "settings": []
}
{% endschema %}
