{%- comment -%}
  Reviews / Testimonials Section - The Amendment Company (1776)
  Recreated to match Image 2 reference: 3 clean review quotes with decorative gold quotation marks,
  bold author names, gold rating stars, and the official circular seal badge image on the right.
{%- endcomment -%}

<div class="testimonials" style="background-color: var(--color-bg-primary); padding-top: 2.5rem; padding-bottom: 3rem; border-top: 1px solid rgba(13,27,42,0.12);">
  <div class="page-width">
    
    {%- comment -%} Reviews Container: 3 Review Items + Far Right Circular Seal Badge {%- endcomment -%}
    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 2rem; align-items: center;">
      
      {%- for block in section.blocks -%}
        <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
          
          {%- comment -%} Large Gold Quote Icon “ {%- endcomment -%}
          <span style="font-family: 'Playfair Display', Georgia, serif; color: #C5A059; font-size: 2.5rem; line-height: 0.8; opacity: 0.85; user-select: none;">
            “
          </span>

          <div style="display: flex; flex-direction: column; justify-content: space-between; height: 100%;">
            <p style="font-size: 0.84rem; color: #0D1B2A; line-height: 1.5; margin-bottom: 0.85rem; font-weight: 400;">
              "{{ block.settings.quote }}"
            </p>
            <div style="display: flex; align-items: center; gap: 0.6rem; font-size: 0.82rem;">
              <span style="font-weight: 800; color: #0D1B2A; font-family: var(--font-body);">
                {{ block.settings.author }}
              </span>
              <span style="color: #C5A059; font-size: 0.78rem; letter-spacing: 0.05em;">
                ★★★★★
              </span>
            </div>
          </div>

        </div>
      {%- endfor -%}

      {%- comment -%} Far Right Circular Seal Badge Image (uni-1.1_a_replicate_this_image (1).png) {%- endcomment -%}
      <div style="display: flex; align-items: center; justify-content: center; padding-left: 1rem;">
        <img
          src="{{ 'uni-1.1_a_replicate_this_image (1).png' | asset_url }}"
          alt="Live Your Values - 1776 Estd. USA"
          width="120"
          height="120"
          style="width: 115px; height: 115px; object-fit: contain; border-radius: 50%;"
        >
      </div>

    </div>

  </div>
</div>

<style>
  @media (max-width: 1024px) {
    .testimonials .page-width > div {
      grid-template-columns: 1fr 1fr !important;
      gap: 1.5rem !important;
    }
  }
  @media (max-width: 640px) {
    .testimonials .page-width > div {
      grid-template-columns: 1fr !important;
    }
  }
</style>

{% schema %}
{
  "name": "Testimonials",
  "max_blocks": 3,
  "settings": [],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Outstanding quality and fast shipping. Proud to support an American brand that stands for something."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Michael T."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "author": "Michael T.", "quote": "Outstanding quality and fast shipping. Proud to support an American brand that stands for something." } },
        { "type": "testimonial", "settings": { "author": "Sarah K.", "quote": "The designs are bold, the fit is perfect, and the message is what this country needs right now." } },
        { "type": "testimonial", "settings": { "author": "James R.", "quote": "Every piece I own from here starts conversations. Great products and even better mission." } }
      ]
    }
  ]
}
{% endschema %}
