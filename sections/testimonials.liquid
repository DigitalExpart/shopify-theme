{%- comment -%}
  Testimonials & Client Reviews Section
{%- endcomment -%}

<div class="testimonials section-spacing" style="background-color: var(--color-bg-primary);">
  <div class="page-width">
    <div style="text-align: center; margin-bottom: 3rem;">
      <span class="subheading">{{ section.settings.subheading | default: 'Client Endorsements' }}</span>
      <h2>{{ section.settings.heading | default: 'Words of Appreciation' }}</h2>
    </div>

    <div class="grid grid--3-col">
      {%- for block in section.blocks -%}
        <div class="testimonial-card" style="background: var(--color-bg-secondary); border-radius: var(--radius-md); padding: 2rem; border: 1px solid var(--color-border); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            {% render 'rating-stars', rating: block.settings.rating %}
            <p style="font-size: 1.05rem; font-style: italic; color: var(--color-text-primary); line-height: 1.6; margin-top: 1.25rem; margin-bottom: 1.5rem;">
              "{{ block.settings.quote }}"
            </p>
          </div>
          <div class="flex items-center gap-md" style="border-top: 1px solid var(--color-border); padding-top: 1.25rem;">
            <div style="width: 44px; height: 44px; border-radius: var(--radius-full); background: var(--color-bg-tertiary); display: flex; align-items: center; justify-content: center; font-weight: var(--font-weight-bold); color: var(--color-text-primary);">
              {{ block.settings.author | slice: 0, 1 }}
            </div>
            <div>
              <h4 style="font-size: 0.95rem; font-family: var(--font-body); font-weight: var(--font-weight-bold); margin: 0;">
                {{ block.settings.author }}
              </h4>
              <span style="font-size: 0.75rem; color: var(--color-accent-gold); font-weight: var(--font-weight-medium);">
                Verified Buyer &bull; {{ block.settings.location }}
              </span>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Client Endorsements"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Words of Appreciation"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5,
          "label": "Star Rating"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The attention to detail and tactile quality surpassed my highest expectations. Truly an investment piece."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Eleanor Vance"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "London, UK"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "author": "Julian Vance", "quote": "Remarkable craft and timeless execution. Customer service was exquisite from start to delivery.", "location": "New York, USA" } },
        { "type": "testimonial", "settings": { "author": "Sophia Laurent", "quote": "Every detail feels curated. The materials used are exceptional and feel far superior to mass market offerings.", "location": "Paris, France" } },
        { "type": "testimonial", "settings": { "author": "Marcus Sterling", "quote": "Solid weight, flawless finishing, and arrived beautifully packaged within 48 hours.", "location": "Tokyo, Japan" } }
      ]
    }
  ]
}
{% endschema %}
