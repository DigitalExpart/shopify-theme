{%- comment -%}
  Testimonials & Client Reviews Section - The Amendment Company
{%- endcomment -%}

<div class="testimonials section-spacing" style="background-color: var(--color-bg-primary); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);">
  <div class="page-width">
    <div style="text-align: center; margin-bottom: 3rem;">
      <span class="subheading" style="font-size: 0.9rem; letter-spacing: 0.15em;">
        ★ REVIEWS ★
      </span>
    </div>

    <div class="flex items-center gap-xl" style="flex-wrap: wrap;">

      <div class="grid grid--3-col" style="flex: 1; min-width: 300px;">
        {%- for block in section.blocks -%}
          <div class="testimonial-card" style="background: var(--color-bg-secondary); border-radius: var(--radius-md); padding: 1.75rem; border: 1px solid var(--color-border); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <p style="font-size: 0.95rem; font-style: italic; color: var(--color-text-primary); line-height: 1.6; margin-bottom: 1.25rem;">
                "{{ block.settings.quote }}"
              </p>
            </div>
            <div class="flex-between" style="border-top: 1px solid var(--color-border); padding-top: 1rem;">
              <div>
                <h4 style="font-size: 0.95rem; font-family: var(--font-body); font-weight: var(--font-weight-bold); margin: 0;">
                  {{ block.settings.author }}
                </h4>
              </div>
              {% render 'rating-stars', rating: block.settings.rating %}
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- comment -%} Circular Stamp Badge {%- endcomment -%}
      <div class="flex-center" style="width: 140px; height: 140px; border-radius: var(--radius-full); border: 2px dashed var(--color-accent-gold); padding: 0.5rem; text-align: center; color: var(--color-text-primary); background: var(--color-bg-secondary); box-shadow: var(--shadow-sm); margin: 0 auto;">
        <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; height: 100%; border: 1px solid var(--color-border); border-radius: var(--radius-full); padding: 0.5rem;">
          <span style="font-size: 0.65rem; font-weight: var(--font-weight-bold); letter-spacing: 0.1em; color: var(--color-accent-gold); text-transform: uppercase;">USE YOUR VALUES</span>
          <span style="font-size: 1.1rem; font-weight: bold; margin: 2px 0;">1776</span>
          <span style="font-size: 0.6rem; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.08em;">ESTD. USA</span>
        </div>
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "max_blocks": 3,
  "settings": [],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5,
          "label": "Star Rating"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Outstanding quality and fast shipping. Proud to support an American brand that stands for something."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Michael T."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "author": "Michael T.", "quote": "Outstanding quality and fast shipping. Proud to support an American brand that stands for something." } },
        { "type": "testimonial", "settings": { "author": "Sarah K.", "quote": "The designs are bold, the fit is perfect, and the message is what this country needs right now." } },
        { "type": "testimonial", "settings": { "author": "James R.", "quote": "Every piece I own from here starts conversations. Great products and even better mission." } }
      ]
    }
  ]
}
{% endschema %}
