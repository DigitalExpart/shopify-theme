{%- comment -%}
  Full Width Banner 2: A Brand With Meaning - The Amendment Company
  Exact reference replica: Full-width banner with background seedream-5.0-pro_a_help_replicate_this_.jpeg,
  left-aligned Oswald heavy condensed typography and red CTA button.
{%- endcomment -%}

<div class="brand-meaning-banner" style="position: relative; width: 100%; min-height: 380px; display: flex; align-items: center; justify-content: flex-start; overflow: hidden; background-color: #0D1B2A;">
  {%- liquid
    assign banner_img = section.settings.image
    if banner_img != blank
      assign banner_src = banner_img | image_url: width: 2000
    else
      assign banner_src = 'seedream-5.0-pro_a_help_replicate_this_.jpeg' | asset_url
    endif
  -%}
  <img
    src="{{ banner_src }}"
    alt="A Brand With Meaning"
    loading="lazy"
    width="2000"
    height="900"
    style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;"
  >

  {%- comment -%} Left-sided dark overlay to make white text pop crisp {%- endcomment -%}
  <div style="position: absolute; inset: 0; background: linear-gradient(to right, rgba(0, 0, 0, 0.78) 0%, rgba(0, 0, 0, 0.48) 45%, rgba(0, 0, 0, 0.08) 100%);"></div>

  <div class="page-width" style="position: relative; z-index: 2; padding-top: 4rem; padding-bottom: 4rem; text-align: left; width: 100%;">
    <div style="max-width: 520px; text-align: left;">

      <h2 style="font-family: 'Oswald', 'Impact', sans-serif; color: #FFFFFF; font-size: clamp(2.4rem, 4.2vw, 3.4rem); font-weight: 800; text-transform: uppercase; letter-spacing: 0.02em; line-height: 1.05; margin-bottom: 0.75rem; text-align: left;">
        {{ section.settings.heading | default: 'A BRAND WITH MEANING' }}
      </h2>

      <p style="color: #F8F5F0; font-size: 1.05rem; line-height: 1.5; margin-bottom: 1.75rem; max-width: 480px; font-weight: 400; text-align: left;">
        {{ section.settings.text | default: "More than apparel—it's a way of life.<br>Wear your values. Live with purpose." }}
      </p>

      <div style="text-align: left;">
        {% render 'button', label: 'EXPLORE THE STORY', link: section.settings.link, style: 'primary' %}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Brand With Meaning Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A BRAND WITH MEANING"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "More than apparel—it's a way of life.<br>Wear your values. Live with purpose."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Brand With Meaning Banner"
    }
  ]
}
{% endschema %}
