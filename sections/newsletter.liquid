{%- comment -%}
  Full Width Banner: A Brand With Meaning - The Amendment Company
{%- endcomment -%}

<div class="brand-meaning-banner section-spacing" style="position: relative; background-color: var(--color-text-primary); color: #FFFFFF; text-align: center; min-height: 420px; display: flex; align-items: center; justify-content: center; overflow: hidden;">
  {%- liquid
    assign banner_img = section.settings.image
    if banner_img != blank
      assign banner_src = banner_img | image_url: width: 2000
    else
      assign banner_src = 'uni-1.1_a_remove_the_text_on_t.png' | asset_url
    endif
  -%}
  <img src="{{ banner_src }}" alt="A Brand With Meaning" loading="lazy" width="2000" height="800" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;">

  <div style="position: absolute; inset: 0; background-color: rgba(13, 27, 42, 0.45);"></div>

  <div class="page-width page-width--narrow" style="position: relative; z-index: 2; padding-top: 4rem; padding-bottom: 4rem;">
    <h2 style="color: #FFFFFF; font-size: clamp(2.25rem, 4.5vw, 3.5rem); margin-bottom: 1rem; font-family: var(--font-heading); text-transform: uppercase; letter-spacing: -0.01em;">
      {{ section.settings.heading | default: 'A BRAND WITH MEANING' }}
    </h2>
    <p style="color: #F1F5F9; font-size: 1.2rem; line-height: 1.6; margin-bottom: 2.25rem; max-width: 640px; margin-left: auto; margin-right: auto;">
      {{ section.settings.text | default: "More than apparel—it's a way of life. Wear your values. Live with purpose." }}
    </p>

    <div>
      {% render 'button', label: 'EXPLORE THE STORY', link: section.settings.link, style: 'primary' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Brand With Meaning Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A BRAND WITH MEANING"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "More than apparel—it's a way of life. Wear your values. Live with purpose."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Brand With Meaning Banner"
    }
  ]
}
{% endschema %}
