{%- comment -%}
  Global Announcement Bar Section - The Amendment Company
{%- endcomment -%}

{%- if section.settings.show_announcement -%}
  <div class="announcement-bar" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; padding: 0.6rem 1rem; text-align: center; font-size: 0.85rem; font-weight: var(--font-weight-semibold); letter-spacing: 0.08em; text-transform: uppercase; position: relative; z-index: calc(var(--z-header) + 1); border-bottom: 1px solid rgba(197, 160, 89, 0.3);">
    <div class="page-width flex-center gap-sm">
      <span style="color: var(--color-accent-gold); font-size: 0.9rem;">★ ★ ★</span>
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" style="color: inherit; text-decoration: underline;">
          {{ section.settings.text }}
        </a>
      {%- else -%}
        <span>{{ section.settings.text }}</span>
      {%- endif -%}
      <span style="color: var(--color-accent-gold); font-size: 0.9rem;">★ ★ ★</span>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "Proudly American. Constitutionally Inspired. Freedom Forever."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Announcement Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#8B1E1E"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#F8F5F0"
    }
  ]
}
{% endschema %}
