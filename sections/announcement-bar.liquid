{%- comment -%}
  Global Announcement Bar Section
{%- endcomment -%}

{%- if section.settings.show_announcement -%}
  <div class="announcement-bar" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; padding: 0.5rem 1rem; text-align: center; font-size: 0.85rem; font-weight: var(--font-weight-medium); position: relative; z-index: calc(var(--z-header) + 1);">
    <div class="page-width flex-center gap-sm">
      {%- if section.settings.icon != 'none' -%}
        <span style="display: inline-flex; align-items: center; color: var(--color-accent-gold);">
          {%- case section.settings.icon -%}
            {%- when 'truck' -%}{% render 'icon-truck' %}
            {%- when 'shield' -%}{% render 'icon-shield' %}
            {%- when 'refresh' -%}{% render 'icon-refresh' %}
            {%- when 'star' -%}{% render 'icon-star' %}
          {%- endcase -%}
        </span>
      {%- endif -%}

      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" style="color: inherit; text-decoration: underline;">
          {{ section.settings.text }}
        </a>
      {%- else -%}
        <span>{{ section.settings.text }}</span>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "Complimentary Worldwide Shipping on Orders Over $150"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Announcement Link"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "truck", "label": "Shipping Truck" },
        { "value": "shield", "label": "Security Shield" },
        { "value": "refresh", "label": "Return Refresh" },
        { "value": "star", "label": "Star Accent" }
      ],
      "default": "truck"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0D1B2A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FAF8F5"
    }
  ]
}
{% endschema %}
