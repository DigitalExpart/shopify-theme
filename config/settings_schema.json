[
  {
    "name": "theme_info",
    "theme_name": "Apex Modern Premium",
    "theme_version": "1.0.0",
    "theme_author": "Antigravity Engineering",
    "theme_documentation_url": "https://help.shopify.com",
    "theme_support_url": "https://support.shopify.com"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Primary Palette"
      },
      {
        "type": "color",
        "id": "color_bg_primary",
        "label": "Background Primary (Cream)",
        "default": "#FAF8F5"
      },
      {
        "type": "color",
        "id": "color_bg_secondary",
        "label": "Background Secondary (Card)",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_text_primary",
        "label": "Text Primary (Navy)",
        "default": "#0D1B2A"
      },
      {
        "type": "color",
        "id": "color_text_muted",
        "label": "Text Muted",
        "default": "#5A6578"
      },
      {
        "type": "color",
        "id": "color_accent_gold",
        "label": "Accent Gold",
        "default": "#C5A059"
      },
      {
        "type": "color",
        "id": "color_cta_bg",
        "label": "Button CTA Background",
        "default": "#C02626"
      },
      {
        "type": "color",
        "id": "color_cta_hover",
        "label": "Button CTA Hover",
        "default": "#9E1B1B"
      },
      {
        "type": "color",
        "id": "color_cta_text",
        "label": "Button CTA Text",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border & Divider",
        "default": "#E6E1D8"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_header_font",
        "label": "Heading Font",
        "default": "serif"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body Font",
        "default": "sans-serif"
      },
      {
        "type": "range",
        "id": "type_body_scale",
        "min": 80,
        "max": 120,
        "step": 5,
        "unit": "%",
        "label": "Body font size scale",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 10,
        "default": 1300,
        "unit": "px",
        "label": "Maximum page width"
      },
      {
        "type": "range",
        "id": "space_between_sections",
        "min": 20,
        "max": 100,
        "step": 10,
        "default": 60,
        "unit": "px",
        "label": "Section vertical spacing"
      }
    ]
  },
  {
    "name": "Cart & Drawer",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "options": [
          {
            "value": "drawer",
            "label": "Slide-out Drawer"
          },
          {
            "value": "page",
            "label": "Cart Page"
          }
        ],
        "default": "drawer",
        "label": "Cart Type"
      },
      {
        "type": "checkbox",
        "id": "show_cart_note",
        "default": true,
        "label": "Enable order notes"
      },
      {
        "type": "checkbox",
        "id": "enable_quick_add",
        "default": true,
        "label": "Enable Quick Add to Cart on product cards"
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_twitter_link",
        "label": "X / Twitter URL"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "Pinterest URL"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube URL"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok URL"
      }
    ]
  }
]
