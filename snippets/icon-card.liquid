{%- comment -%}
  Renders a trust badge icon card.
  Accepts:
  - icon_name: {String} 'truck' | 'shield' | 'refresh' | 'star'
  - title: {String} Card title
  - subtitle: {String} Card subtitle
{%- endcomment -%}

<div class="icon-card flex items-center gap-md" style="background: var(--color-bg-secondary); padding: 1.5rem; border-radius: var(--radius-sm); border: 1px solid var(--color-border);">
  <div class="flex-center" style="width: 52px; height: 52px; border-radius: var(--radius-full); background: var(--color-bg-tertiary); color: var(--color-accent-gold); shrink: 0;">
    {%- case icon_name -%}
      {%- when 'truck' -%}
        {% render 'icon-truck' %}
      {%- when 'shield' -%}
        {% render 'icon-shield' %}
      {%- when 'refresh' -%}
        {% render 'icon-refresh' %}
      {%- else -%}
        {% render 'icon-star' %}
    {%- endcase -%}
  </div>

  <div>
    <h4 style="font-size: 1.05rem; font-family: var(--font-body); font-weight: var(--font-weight-semibold); margin-bottom: 0.2rem;">
      {{ title | default: 'Feature Title' }}
    </h4>
    <p style="font-size: 0.85rem; color: var(--color-text-muted); margin: 0;">
      {{ subtitle | default: 'Feature subtitle detail' }}
    </p>
  </div>
</div>
