{%- comment -%}
  Renders a collection/category card - The Amendment Company
  Accepts:
  - collection: {Object} Collection Liquid object
  - title: {String} Optional custom title
  - image: {Object} Optional custom image
  - link: {String} Optional custom link URL
{%- endcomment -%}

{%- liquid
  assign card_collection = collection
  assign card_image = image | default: card_collection.featured_image
  assign card_title = title | default: card_collection.title | default: 'PREMIUM TEES'
  assign card_url = link | default: card_collection.url | default: '#'
-%}

<a href="{{ card_url }}" class="category-card media-wrapper media-wrapper--portrait" style="border-radius: var(--radius-sm); overflow: hidden; display: block; position: relative; border: 1px solid var(--color-border);">
  {%- if card_image -%}
    <img
      src="{{ card_image | image_url: width: 600 }}"
      alt="{{ card_title | escape }}"
      loading="lazy"
      width="600"
      height="750"
    >
  {%- else -%}
    {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
  {%- endif -%}

  <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(13,27,42,0.92) 0%, rgba(13,27,42,0.15) 60%);"></div>

  <div style="position: absolute; inset: 0; padding: 1.25rem; display: flex; flex-direction: column; justify-content: flex-end; color: #FFFFFF; text-align: center;">
    <h3 style="font-size: 1.15rem; font-family: var(--font-heading); color: #FFFFFF; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.25rem;">
      {{ card_title }}
    </h3>
    <span style="font-size: 0.8rem; color: var(--color-accent-gold); font-weight: var(--font-weight-semibold); text-transform: uppercase; letter-spacing: 0.08em;">
      Shop Now &rarr;
    </span>
  </div>
</a>
