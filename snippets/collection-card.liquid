{%- comment -%}
  Renders a collection/category card.
  Accepts:
  - collection: {Object} Collection Liquid object
  - title: {String} Optional custom title
  - image: {Object} Optional custom image
  - link: {String} Optional custom link URL
{%- endcomment -%}

{%- liquid
  assign card_collection = collection
  assign card_image = image | default: card_collection.featured_image
  assign card_title = title | default: card_collection.title | default: 'Category Name'
  assign card_url = link | default: card_collection.url | default: '#'
-%}

<a href="{{ card_url }}" class="collection-card media-wrapper media-wrapper--portrait" style="display: block; border-radius: var(--radius-md); overflow: hidden; position: relative;">
  {%- if card_image -%}
    <img
      src="{{ card_image | image_url: width: 800 }}"
      alt="{{ card_title | escape }}"
      loading="lazy"
      width="800"
      height="1000"
    >
  {%- else -%}
    {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
  {%- endif -%}

  <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(13,27,42,0.85) 0%, rgba(13,27,42,0.1) 60%); display: flex; flex-direction: column; justify-content: flex-end; padding: 2rem; color: #FFFFFF;">
    <h3 style="color: #FFFFFF; font-size: 1.5rem; margin-bottom: 0.5rem; font-family: var(--font-heading);">
      {{ card_title }}
    </h3>
    <span class="btn btn--gold btn--sm" style="align-self: flex-start; pointer-events: none;">
      Explore Collection
    </span>
  </div>
</a>
