{%- comment -%}
  Renders pagination controls.
  Accepts:
  - paginate: {Object} Shopify Paginate liquid object
{%- endcomment -%}

{%- if paginate.parts.size > 0 -%}
  <nav class="pagination flex-center gap-sm" role="navigation" aria-label="Pagination" style="margin-top: 3rem; margin-bottom: 2rem;">
    {%- if paginate.previous -%}
      <a href="{{ paginate.previous.url }}" class="btn btn--outline btn--sm" aria-label="Previous page">
        &larr; Prev
      </a>
    {%- endif -%}

    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a href="{{ part.url }}" class="btn btn--outline btn--sm" style="min-width: 40px; padding: 0.5rem 0.75rem;">
          {{ part.title }}
        </a>
      {%- else -%}
        {%- if part.title == paginate.current_page -%}
          <span class="btn btn--primary btn--sm" aria-current="page" style="min-width: 40px; padding: 0.5rem 0.75rem;">
            {{ part.title }}
          </span>
        {%- else -%}
          <span style="padding: 0.5rem 0.75rem; color: var(--color-text-muted);">
            {{ part.title }}
          </span>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if paginate.next -%}
      <a href="{{ paginate.next.url }}" class="btn btn--outline btn--sm" aria-label="Next page">
        Next &rarr;
      </a>
    {%- endif -%}
  </nav>
{%- endif -%}
