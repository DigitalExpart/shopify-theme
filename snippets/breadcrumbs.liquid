{%- unless template == 'index' or template == 'cart' or template == '404' -%}
  <nav class="breadcrumbs page-width" aria-label="Breadcrumb" style="padding-top: 1.5rem; padding-bottom: 1rem; font-size: 0.85rem; color: var(--color-text-muted);">
    <ol style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
      <li>
        <a href="{{ routes.root_url }}" style="color: var(--color-text-muted);">Home</a>
      </li>
      <li aria-hidden="true" style="color: var(--color-border-dark);">&sol;</li>

      {%- if template contains 'product' -%}
        {%- if collection.url -%}
          <li>
            <a href="{{ collection.url }}" style="color: var(--color-text-muted);">{{ collection.title }}</a>
          </li>
          <li aria-hidden="true" style="color: var(--color-border-dark);">&sol;</li>
        {%- endif -%}
        <li>
          <span aria-current="page" style="color: var(--color-text-primary); font-weight: var(--font-weight-medium);">{{ product.title }}</span>
        </li>
      {%- elsif template contains 'collection' and collection.handle -%}
        <li>
          <span aria-current="page" style="color: var(--color-text-primary); font-weight: var(--font-weight-medium);">{{ collection.title }}</span>
        </li>
      {%- elsif template contains 'page' -%}
        <li>
          <span aria-current="page" style="color: var(--color-text-primary); font-weight: var(--font-weight-medium);">{{ page.title }}</span>
        </li>
      {%- else -%}
        <li>
          <span aria-current="page" style="color: var(--color-text-primary); font-weight: var(--font-weight-medium);">{{ page_title }}</span>
        </li>
      {%- endif -%}
    </ol>
  </nav>
{%- endunless -%}
