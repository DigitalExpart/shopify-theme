{%- comment -%}
  Renders a modern, accessible product card.
  Accepts:
  - product_card_product: {Object} Product liquid object
  - show_vendor: {Boolean} Show product vendor
  - show_quick_add: {Boolean} Show Quick Add button
{%- endcomment -%}

{%- liquid
  assign card_product = product_card_product
  assign featured_media = card_product.featured_media
  assign second_media = card_product.media[1]
  assign first_variant = card_product.selected_or_first_available_variant
-%}

<div class="product-card" style="position: relative; background: var(--color-bg-secondary); border-radius: var(--radius-sm); border: 1px solid var(--color-border); padding: 1rem; transition: box-shadow var(--transition-base), transform var(--transition-base);">
  {%- comment -%} Badges {%- endcomment -%}
  <div style="position: absolute; top: 1.5rem; left: 1.5rem; z-index: 2; display: flex; flex-direction: column; gap: 0.25rem;">
    {%- if card_product.available == false -%}
      {% render 'badge', type: 'soldout' %}
    {%- elsif card_product.compare_at_price > card_product.price -%}
      {% render 'badge', type: 'sale' %}
    {%- endif -%}
  </div>

  {%- comment -%} Wishlist Toggle Placeholder {%- endcomment -%}
  <button type="button" class="icon-btn" aria-label="Add to Wishlist" style="position: absolute; top: 1.25rem; right: 1.25rem; z-index: 2; background: rgba(255,255,255,0.85); backdrop-filter: blur(4px);">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.78-8.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
  </button>

  {%- comment -%} Product Image Media Container {%- endcomment -%}
  <a href="{{ card_product.url }}" class="media-wrapper media-wrapper--portrait" style="margin-bottom: 1rem;">
    {%- if featured_media -%}
      <img
        src="{{ featured_media | image_url: width: 600 }}"
        alt="{{ featured_media.alt | escape }}"
        loading="lazy"
        width="600"
        height="750"
      >
      {%- if second_media -%}
        <img
          src="{{ second_media | image_url: width: 600 }}"
          alt="{{ second_media.alt | escape }}"
          loading="lazy"
          width="600"
          height="750"
          style="opacity: 0; transition: opacity var(--transition-base);"
          onmouseenter="this.style.opacity=1"
          onmouseleave="this.style.opacity=0"
        >
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </a>

  {%- comment -%} Product Details {%- endcomment -%}
  <div class="product-card__content" style="display: flex; flex-direction: column; gap: 0.4rem;">
    {%- if show_vendor and card_product.vendor != blank -%}
      <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-muted);">
        {{ card_product.vendor }}
      </span>
    {%- endif -%}

    <h3 style="font-size: 1.05rem; font-family: var(--font-body); font-weight: var(--font-weight-semibold); line-height: 1.3;">
      <a href="{{ card_product.url }}" style="color: var(--color-text-primary);">
        {{ card_product.title | default: 'Sample Product Title' }}
      </a>
    </h3>

    {% render 'rating-stars', rating: 4.8, count: 24 %}

    {% render 'price', product: card_product, price_class: 'margin-top: 0.25rem;' %}

    {%- if show_quick_add != false and first_variant -%}
      <button
        type="button"
        class="btn btn--primary btn--full btn--sm"
        style="margin-top: 0.75rem;"
        data-quick-add="{{ first_variant.id }}"
        {% unless card_product.available %}disabled{% endunless %}
      >
        {%- if card_product.available -%}
          {{ 'products.product.quick_add' | t }}
        {%- else -%}
          {{ 'products.product.sold_out' | t }}
        {%- endif -%}
      </button>
    {%- endif -%}
  </div>
</div>
