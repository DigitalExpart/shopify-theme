{%- comment -%}
  Renders a product's price.
  Accepts:
  - product: {Object} Product Liquid object
  - use_variant: {Boolean} Whether to use target variant
  - price_class: {String} Extra CSS class
{%- endcomment -%}

{%- liquid
  if use_variant and product.selected_or_first_available_variant
    assign target = product.selected_or_first_available_variant
  else
    assign target = product
  endif

  assign compare_at_price = target.compare_at_price
  assign price = target.price | default: 1999
  assign money_price = price | money
-%}

<div class="price {%- if compare_at_price > price %} price--sale{%- endif %} {{ price_class }}">
  {%- if compare_at_price > price -%}
    <span class="price__sale">{{ money_price }}</span>
    <span class="price__regular">{{ compare_at_price | money }}</span>
  {%- else -%}
    <span class="price__regular">{{ money_price }}</span>
  {%- endif -%}
</div>
